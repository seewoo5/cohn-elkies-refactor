        Real.logb 2 (2 * Real.pi / Real.exp 1))) := by
  simpa [CohnElkies.SharpBinaryLogAsymptotic,
    CohnElkies.criticalBinaryExponent] using!
    CohnElkies.sharpBinaryLogAsymptotic

