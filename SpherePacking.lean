      Real.Gamma (ℓ / 2 + (j + 3)) *
      Real.exp (2 * |ℓ| * saddleShellTotalVariation ε)), ?_, ?_⟩
  · have hgamma : 0 < Real.Gamma (ℓ / 2 + (j + 3)) :=
