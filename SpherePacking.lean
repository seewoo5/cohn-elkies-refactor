  change
    |t| *
      ‖minusSaddleFiniteRapidContourIntegrand ε ℓ N r z‖ ≤
        D + G
  unfold minusSaddleFiniteRapidContourIntegrand
  rw [minusSaddleFiniteRapidPoleRegularPart_eq_subtraction_of_not_pole
