def plusSaddleFinitePoleSubtraction
    (ε ℓ : ℝ) (N : ℕ) (z : ℂ) : ℂ :=
  plusSaddleMellinData ε ℓ z -
    ∑ n ∈ Finset.range (N + 1),
      plusSaddlePoleResidue ε ℓ n /
        (z + ((2 * n : ℕ) : ℂ))

