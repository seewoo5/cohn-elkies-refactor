            ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ *
              (∫ T : ℝ,
                saddleSourceGaussianKernel ε ℓ u T) := hfull
      _ = (1 / 2 : ℝ) *
          ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ *
            (∫ T : ℝ,
              saddleSourceGaussianKernel ε ℓ u T) := by
        try dsimp [a]
        field_simp [hsqrt.ne']
        ring
      _ < ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ *
