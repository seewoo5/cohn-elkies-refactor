        (fun T : ℝ =>
          ∫ a in A..B,
            F ((a : ℂ) + (T : ℂ) * Complex.I))
        Filter.atTop (𝓝 0) := by
    simpa [F] using!
      minusSaddleMellinData_weighted_horizontalIntegral_tendsto_zero
