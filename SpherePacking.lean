        Real.logb 2 (fullLinearProgram d) / (d : ℝ))
      atTop
      (nhds (-(1 / 2 : ℝ) *
        Real.logb 2 (2 * Real.pi / Real.exp 1))) := by
  simpa only [fullLinearProgram_eq_radial] using
    RadialMain.exact_binary_exponent

