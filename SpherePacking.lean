        (stripRegularizedHolomorphicPoissonKernel
          ((d : ℝ) / 2)
          (((((d : ℝ) / 2) * s : ℝ) : ℂ) +
            Complex.I * ((σ * ((d : ℝ) / 2) : ℝ) : ℂ))
          (((d : ℝ) / 2) * Y) *
