    Tendsto
        (fun d : ℕ =>
          sInf {q : ℝ | ∃ f : FullAdmissible d,
            fullQuotient f ^ ((d : ℝ)⁻¹) = q} /
            Real.sqrt (d : ℝ))
        atTop (𝓝 (1 / Real.pi)) ∧
      (∃ err : ℕ → ℝ,
        Tendsto err atTop (𝓝 0) ∧
        ∀ d : ℕ, 0 < d →
